# Athletic Diagnostic System (ADS) - Environment Configuration
# NOTE: ADS is designed as a 100% client-side, air-gapped deterministic application.
# Zero external API keys or cloud credentials are required or accepted.
# All calculations compute in local browser memory and localStorage.

# Node environment (development | production)
NODE_ENV=development

# Optional: Next.js Telemetry Opt-Out
NEXT_TELEMETRY_DISABLED=1
